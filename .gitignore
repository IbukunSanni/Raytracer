# Build output
build/
*.o
*.a
*.exe

# NOT *.obj. Wavefront models share the extension with MSVC object files,
# and assets/models/*.obj are source assets. The rule used to be here and
# would have silently swallowed the next model added -- the models already here
# survive only because they were tracked before it. Object files live under
# build/, which is already ignored.

# Render output -- regenerate by running the scene.
# The globs recurse: plain renders/*.png never reached renders/test/, which
# is how a 6.5 MB PNG ended up in history.
renders/**/*.png
renders/**/*.mp4
tests/out/
/*.png
*.mp4

# Textures stay local: source images run to hundreds of MB, past what git
# and GitHub accept. A file git already tracks stays tracked whatever this
# says, so the backgrounds the old scenes use are unaffected. uv_grid.png is
# a test fixture: texture_test reads it. A scene naming any other image that
# is not here renders the placeholder checker instead.
assets/textures/*
!assets/textures/uv_grid.png
# Licences stay in git even when the image they cover cannot.
!assets/textures/*_license.txt

# Editor / OS
.vs/
.idea/
.DS_Store
*.swp
*.swo

# NFS lock files (accidental, from the lab filesystem)
.nfs*
