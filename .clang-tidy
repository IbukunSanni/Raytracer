# Google C++ Style Guide: https://google.github.io/styleguide/cppguide.html
#
# .clang-format handles whitespace; this file handles the rules that need to
# see the code's meaning -- what is a private member, what is a compile-time
# constant, what is a parameter. Run it with scripts/check_style.sh.
---
Checks: >
  -*,
  readability-identifier-naming,
  google-build-using-namespace,
  google-explicit-constructor,
  google-global-names-in-headers,
  google-readability-casting,
  modernize-use-override

# modernize-use-nullptr is deliberately absent: it segfaults the clang-tidy
# that ships with Visual Studio 2022 (0xC0000005) when parsing this tree
# against GCC 15's libstdc++. Nothing in src/ or tests/ uses NULL, so the
# check has nothing to find here anyway. Try it again on a newer LLVM.

WarningsAsErrors: '*'
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '.*(third_party|doctest).*'

CheckOptions:
  # Types.
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase

  # Functions. Note what CamelCase does to an acronym, because it is not
  # uniform: a name that ALREADY satisfies the rule is left exactly as it
  # is, so the types AABB, BVH, BVHNode keep the spelling the graphics
  # literature uses. A name that has to be rewritten is rebuilt from its
  # word split, which lowercases the acronym -- rayTraceRGB became
  # RayTraceRgb and encodeSRGB became EncodeSrgb, not RayTraceRGB. That
  # matches Google's "treat abbreviations as words", so the result is
  # right; it is just reached by two different routes.
  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.GlobalFunctionCase: CamelCase
  # MethodCase, not ClassMethodCase: in clang-tidy the latter means an
  # Objective-C class method and silently matches nothing here.
  readability-identifier-naming.MethodCase: CamelCase

  # Variables: snake_case everywhere, with a trailing underscore on the
  # non-public data members of a class.
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.LocalVariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.MemberCase: lower_case
  readability-identifier-naming.PublicMemberCase: lower_case
  readability-identifier-naming.PrivateMemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: _
  readability-identifier-naming.ProtectedMemberCase: lower_case
  readability-identifier-naming.ProtectedMemberSuffix: _

  # Anything whose value is fixed for the life of the program: leading k.
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.EnumConstantPrefix: k
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: k
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.StaticConstantPrefix: k
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ClassConstantPrefix: k

  # MacroDefinitionCase is deliberately NOT set, and the reason is a
  # genuine conflict rather than an oversight. The style guide's include
  # guard is <PROJECT>_<PATH>_<FILE>_H_, with a TRAILING UNDERSCORE, and
  # clang-tidy's UPPER_CASE rejects exactly that. Neither
  # MacroDefinitionIgnoredRegex nor IgnoredRegex is honoured for macros in
  # LLVM 19, so there is no way to keep the check and the guards both.
  # Guards win: they are 24 files, every one of them checked by the
  # compiler, while the macros this would police are a handful of LOG_ and
  # CHECK_ names that already conform. Revisit if a later LLVM makes the
  # ignore regex work.
